# Select exactly one backend: sqlite (default) or mariadb
DB_DRIVER=sqlite
PORT=3000

# MariaDB connection (create database/user on the host first)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=freeai
DB_USER=freeai_app
DB_PASSWORD=replace-with-a-strong-secret
DB_SSL=true

# Keep key and database files outside public_html; back up both securely.
DATA_DIR=/home/ACCOUNT/private/freeai-data

# Mandatory before registration: SMTP sender and public HTTPS URL
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=FreeAI <noreply@example.com>
APP_BASE_URL=https://yourdomain.com

# Google OAuth (optional - get from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitHub OAuth (optional - get from https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# App base URL (required for OAuth callbacks)
